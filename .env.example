# Copy to .env for local runs, or set these as environment variables in Vercel.
# Never commit real values.

# Required for the free-text grading (api/evaluate.js).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional. When set, middleware.js asks for it on every page and API route (HTTP Basic, any user name).
# Leave empty or unset to run without the gate.
ACCESS_CODE=choose-a-long-random-code
